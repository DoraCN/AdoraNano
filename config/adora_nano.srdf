<?xml version="1.0" encoding="utf-8"?>
<!--
  ADORA NANO SRDF - generated by work/urdf/gen_srdf.py.
  disable_collisions reasons:
    Adjacent   parent/child link pair (URDF joint)
    Never      links welded by fixed joints (rigidly connected)
    Default    (a) pairs overlapping at the CAD zero pose (concave CAD hulls)
               and (b) pairs at kinematic distance <= 3, whose convex hulls
               over-approximate the real bracket clearance.  Evidence:
               work/urdf/collision_overlap.json
-->
<robot name="adora_nano">
  <virtual_joint name="virtual_joint" type="fixed" parent_frame="world" child_link="base_link"/>
  <group name="left_arm">
    <chain base_link="base_link" tip_link="left_tool_mount"/>
  </group>
  <group name="right_arm">
    <chain base_link="base_link" tip_link="right_tool_mount"/>
  </group>
  <group name="head">
    <chain base_link="base_link" tip_link="head_tilt"/>
  </group>
  <end_effector name="left_tcp" parent_link="left_tool_mount" group="left_arm" parent_group="left_arm"/>
  <end_effector name="right_tcp" parent_link="right_tool_mount" group="right_arm" parent_group="right_arm"/>
  <disable_collisions link1="base_link" link2="head_mount" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="head_pan" reason="Default"/>  <!-- kinematic distance 2: convex-hull clearance artifact -->
  <disable_collisions link1="base_link" link2="head_tilt" reason="Default"/>  <!-- kinematic distance 2: convex-hull clearance artifact -->
  <disable_collisions link1="base_link" link2="left_forearm" reason="Default"/>  <!-- kinematic distance 2: convex-hull clearance artifact -->
  <disable_collisions link1="base_link" link2="left_shoulder" reason="Adjacent"/>

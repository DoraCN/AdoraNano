  <disable_collisions link1="base_link" link2="right_forearm" reason="Default"/>  <!-- kinematic distance 2: convex-hull clearance artifact -->
  <disable_collisions link1="base_link" link2="right_shoulder" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="right_upper_arm" reason="Default"/>  <!-- kinematic distance 2: convex-hull clearance artifact -->
  <disable_collisions link1="base_link" link2="wheel_1" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="wheel_2" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="wheel_3" reason="Adjacent"/>
